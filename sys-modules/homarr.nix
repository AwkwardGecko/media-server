{
  pkgs,
  lib,
  ...
}: {
  # Runtime
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    dockerCompat = true;
    defaultNetwork.settings = {
      # Required for container networking to be able to use names.
      dns_enabled = true;
    };
  };

  # Enable container name DNS for non-default Podman networks.
  # https://github.com/NixOS/nixpkgs/issues/226365
  networking.firewall.interfaces."podman+".allowedUDPPorts = [53];

  networking.firewall.allowedTCPPorts = [ 7575 ];

  virtualisation.oci-containers.backend = "podman";

  # Containers
  virtualisation.oci-containers.containers."homarr" = {
    image = "ghcr.io/homarr-labs/homarr:latest";
    environment = {
      "SECRET_ENCRYPTION_KEY" = "03647fd5147031e3e5cf8a32bee34fda1d3fe9519296dbf6994a8a994b36f7ac";
    };
    volumes = [
      "/var/lib/homarr:/appdata:rw"
      "/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock:rw"
    ];
    ports = [ "7575:7575/tcp" ];
    labels = {
      "io.containers.autoupdate" = "registry";
    };
    log-driver = "journald";
    extraOptions = [
      "--network-alias=homarr"
      "--network=homarr_default"
    ];
  };
  systemd.services."podman-homarr" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      ExecStartPre = [
        "${pkgs.bash}/bin/bash -c 'sleep 10'"
      ];
    };
    after = [
      "podman-network-homarr_default.service"
    ];
    requires = [
      "podman-network-homarr_default.service"
    ];
    partOf = [
      "podman-compose-homarr-root.target"
    ];
    wantedBy = [
      "podman-compose-homarr-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-homarr_default" = {
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f homarr_default";
    };
    script = ''
      podman network inspect homarr_default || podman network create homarr_default
    '';
    partOf = ["podman-compose-homarr-root.target"];
    wantedBy = ["podman-compose-homarr-root.target"];
  };

  systemd.timers."podman-auto-update" = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnBootSec = "10min";
      OnUnitActiveSec = "1h";
    };
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-homarr-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = ["multi-user.target"];
  };
}
